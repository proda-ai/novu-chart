{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ingress": {
      "type": "object",
      "description": "Ingress configuration",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "host": {
          "type": "string"
        },
        "tls": {
          "type": "object",
          "properties": {
            "secretName": {
              "type": "string"
            }
          }
        },
        "dashboard": {
          "$ref": "#/$defs/ingressDashboard"
        }
      },
      "required": [
        "enabled"
      ],
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "description": "Service type configuration",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ],
          "default": "ClusterIP",
          "description": "Determines how the Service is exposed"
        }
      },
      "required": [
        "type"
      ]
    },
    "secret": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "dashboard": {
      "type": "object",
      "description": "Frontend dashboard component",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            },
            "tag": {
              "type": "string"
            }
          }
        },
        "port": {
          "type": "integer",
          "const": 4000,
          "description": "The published dashboard image listens on port 4000"
        },
        "resources": {
          "type": "object"
        }
      },
      "required": [
        "replicaCount",
        "image",
        "port"
      ]
    },
    "api": {
      "type": "object",
      "description": "Backend API component",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            },
            "tag": {
              "type": "string"
            }
          }
        },
        "port": {
          "type": "integer"
        },
        "resources": {
          "type": "object"
        },
        "contextPath": {
          "type": "string"
        },
        "idempotencyEnabled": {
          "type": "boolean"
        },
        "rateLimitingEnabled": {
          "type": "boolean"
        },
        "newMessagesApiResponseEnabled": {
          "type": "boolean"
        },
        "widgetBaseUrl": {
          "type": "string"
        }
      },
      "required": [
        "replicaCount",
        "image"
      ]
    },
    "worker": {
      "type": "object",
      "description": "Background worker component",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            },
            "tag": {
              "type": "string"
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "broadcastQueueChunkSize": {
          "type": "integer"
        },
        "multicastQueueChunkSize": {
          "type": "integer"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "required": [
        "replicaCount",
        "image"
      ]
    },
    "ws": {
      "type": "object",
      "description": "WebSocket component",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            },
            "tag": {
              "type": "string"
            }
          }
        },
        "port": {
          "type": "integer"
        },
        "contextPath": {
          "type": "string"
        },
        "resources": {
          "type": "object"
        }
      },
      "required": [
        "replicaCount",
        "image"
      ]
    },
    "global": {
      "type": "object",
      "description": "Global variables for all components",
      "properties": {
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "properties": {
            "nodeEnv": {
              "type": "string",
              "enum": [
                "dev",
                "test",
                "production",
                "ci",
                "local"
              ]
            },
            "mongodb": {
              "type": "object",
              "properties": {
                "maxPoolSize": {
                  "type": "integer",
                  "minimum": 0
                },
                "minPoolSize": {
                  "type": "integer",
                  "minimum": 0
                },
                "autoCreateIndexes": {
                  "type": "boolean"
                }
              }
            },
            "secret": {
              "type": "object",
              "properties": {
                "novuSecretKey": {
                  "type": "string"
                },
                "jwtSecret": {
                  "type": "string"
                },
                "storageKey": {
                  "type": "string"
                }
              }
            },
            "s3": {
              "type": "object",
              "properties": {
                "localStack": {
                  "type": "boolean"
                },
                "bucketName": {
                  "type": "string"
                },
                "region": {
                  "type": "string"
                }
              }
            },
            "aws": {
              "type": "object",
              "properties": {
                "accessKeyId": {
                  "type": "string"
                },
                "secretAccessKey": {
                  "type": "string"
                }
              }
            },
            "sentry": {
              "type": "object",
              "properties": {
                "dsn": {
                  "type": "string"
                }
              }
            },
            "newRelic": {
              "type": "object",
              "properties": {
                "appName": {
                  "type": "string"
                },
                "licenseKey": {
                  "type": "string"
                },
                "enabled": {
                  "type": "boolean"
                }
              }
            },
            "apiRootUrl": {
              "type": "string"
            },
            "disableUserRegistration": {
              "type": "boolean"
            },
            "frontBaseUrl": {
              "type": "string"
            },
            "isSelfHosted": {
              "type": "boolean"
            },
            "novuEnterprise": {
              "type": "boolean"
            },
            "isV2Enabled": {
              "type": "boolean"
            },
            "safeOutboundAllow": {
              "type": "string"
            },
            "websocketUrl": {
              "type": "string"
            },
            "logLevel": {
              "type": "string",
              "enum": [
                "trace",
                "debug",
                "info",
                "warn",
                "error",
                "fatal",
                "none"
              ]
            }
          }
        }
      },
      "required": [
        "env"
      ]
    },
    "redis": {
      "type": "object",
      "description": "Redis configuration",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replica": {
          "type": "object",
          "properties": {
            "replicaCount": {
              "type": "integer"
            }
          }
        }
      },
      "required": [
        "enabled"
      ]
    },
    "mongodb": {
      "type": "object",
      "description": "MongoDB configuration",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "serviceBindings": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      },
      "required": [
        "enabled"
      ]
    },
    "upgrade": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "centralize",
        "report",
        "image",
        "bucket",
        "serviceAccountName",
        "operationStateName",
        "operationId",
        "attemptId",
        "syncRevision",
        "mode",
        "deadlines",
        "resources",
        "smoke",
        "workVolumeSize",
        "indexDrops",
        "recheck"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "centralize": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approved"
          ],
          "properties": {
            "approved": {
              "type": "boolean"
            }
          }
        },
        "report": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "recheck": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "image": {
          "type": "string",
          "pattern": "^$|^\\S+@sha256:[a-f0-9]{64}$"
        },
        "bucket": {
          "const": "proda-staging-636c0f80-novu-upgrade"
        },
        "serviceAccountName": {
          "const": "novu-upgrade"
        },
        "operationStateName": {
          "const": "novu-upgrade-state"
        },
        "operationId": {
          "type": "string",
          "pattern": "^$|^[a-z0-9][a-z0-9-]{0,47}$"
        },
        "attemptId": {
          "type": "string",
          "pattern": "^$|^[a-z0-9][a-z0-9-]{0,47}$"
        },
        "syncRevision": {
          "type": "string",
          "pattern": "^$|^[a-f0-9]{40}$"
        },
        "mode": {
          "enum": [
            "upgrade",
            "restore"
          ]
        },
        "indexDrops": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "collection",
              "name",
              "definitionSha256"
            ],
            "properties": {
              "collection": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "definitionSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "workVolumeSize": {
          "type": "string"
        },
        "resources": {
          "type": "object",
          "required": [
            "requests",
            "limits"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory",
                "ephemeral-storage"
              ]
            },
            "limits": {
              "type": "object",
              "required": [
                "cpu",
                "memory",
                "ephemeral-storage"
              ]
            }
          }
        },
        "deadlines": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "quiesce",
            "backup",
            "verify",
            "centralize",
            "precheck",
            "migrate",
            "reconcile-indexes",
            "smoke",
            "failure"
          ],
          "properties": {
            "quiesce": {
              "type": "integer",
              "minimum": 30,
              "maximum": 3600
            },
            "backup": {
              "type": "integer",
              "minimum": 30,
              "maximum": 3600
            },
            "verify": {
              "type": "integer",
              "minimum": 30,
              "maximum": 3600
            },
            "centralize": {
              "type": "integer",
              "minimum": 30,
              "maximum": 3600
            },
            "precheck": {
              "type": "integer",
              "minimum": 30,
              "maximum": 3600
            },
            "migrate": {
              "type": "integer",
              "minimum": 30,
              "maximum": 3600
            },
            "reconcile-indexes": {
              "type": "integer",
              "minimum": 30,
              "maximum": 3600
            },
            "smoke": {
              "type": "integer",
              "minimum": 30,
              "maximum": 3600
            },
            "failure": {
              "type": "integer",
              "minimum": 30,
              "maximum": 3600
            }
          }
        },
        "smoke": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subscriberId",
            "applicationIdentifier",
            "apiKeySecretName",
            "apiKeySecretKey"
          ],
          "properties": {
            "subscriberId": {
              "type": "string"
            },
            "applicationIdentifier": {
              "type": "string"
            },
            "apiKeySecretName": {
              "type": "string"
            },
            "apiKeySecretKey": {
              "type": "string"
            }
          }
        },
        "infobipIntegrationIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{24}$"
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ingressDashboard": {
      "type": "object",
      "description": "Overrides for the dashboard Ingress",
      "properties": {
        "subdomain": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
          "default": "dashboard"
        },
        "annotations": {
          "type": "object",
          "description": "Merged over ingress.annotations",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tls": {
          "type": "object",
          "properties": {
            "secretName": {
              "type": "string",
              "description": "Replaces <ingress.dashboard.subdomain>.<ingress.tls.secretName>"
            }
          }
        }
      }
    }
  }
}
