{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "customManagers:helmChartYamlAppVersions"
  ],
  "forkProcessing": "enabled",
  "timezone": "Europe/Warsaw",
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/novuhq/novu/**"
      ],
      "enabled": true,
      "groupName": "Novu server images",
      "schedule": [
        "* 0-4 * * 1"
      ],
      "automerge": false
    }
  ]
}
